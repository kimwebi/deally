{
    "name": "multitenant/saas-foundation",
    "description": "A production-ready multi-tenancy and SaaS foundation for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "saas", "multi-tenancy", "tenancy"],
    "autoload": {
        "psr-4": {
            "SaasFoundation\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": []
    },
    "extra": {
        "laravel": {
            "providers": [
                "SaasFoundation\\Providers\\SaasFoundationServiceProvider",
                "SaasFoundation\\Providers\\BillingServiceProvider",
                "SaasFoundation\\Providers\\EventServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    }
}